{
	"name": "@asapio/n8n-nodes-asapio",
	"version": "0.1.12",
	"publishConfig": {
		"access": "public"
	},
	"description": "n8n community node to receive events dispatched by the ASAPIO Integration Add-on (Event Studio)",
	"license": "MIT",
	"homepage": "https://github.com/AsapioCompany/n8n-nodes-asapio",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "ASAPIO GmbH",
		"email": "ffa@asapio.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AsapioCompany/n8n-nodes-asapio.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "jest"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AsapioApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/AsapioTrigger/AsapioTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.5",
		"@types/jest": "^29.5.14",
		"eslint": "9.32.0",
		"jest": "^29.7.0",
		"prettier": "3.6.2",
		"release-it": "^20.2.1",
		"ts-jest": "^29.2.5",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
